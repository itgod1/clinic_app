# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# 诊所 API 配置（Java 后端）
CLINIC_API_URL=http://localhost:8080
CLINIC_API_KEY=your-clinic-api-key

# 服务配置
HOST=0.0.0.0
PORT=8000

# 环境
ENVIRONMENT=development
DEBUG=true

# 日志级别
LOG_LEVEL=INFO
